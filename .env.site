# Website build settings, used by `npm run build:site` (the openpaye.ie build).
# The normal `npm run build` ignores this file and makes the self-hosted version.
VITE_SITE_PAGES=1
VITE_SITE_URL=https://openpaye.ie
VITE_REPO_URL=https://github.com/clarkemedia/openpaye
VITE_DONATE_URL=https://www.paypal.com/paypalme/eoinmcm
