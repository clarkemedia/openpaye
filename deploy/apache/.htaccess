# Apache settings for OpenPAYE (Cloudways, cPanel and most shared hosts).
# The site build copies this into the site branch; for your own copy, put it next to index.html.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8
AddCharset UTF-8 .webmanifest .svg

# Use the bare domain: www.example.ie → example.ie
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>

# No cookies, no tracking, no third-party requests (the same rules as nginx.conf)
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-src 'self'; frame-ancestors 'self'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # The embeddable calculator may be framed by any site
  <Files "embed.html">
    Header always set Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; frame-ancestors *"
  </Files>

  # The widget script is loaded by other sites
  <Files "widget.js">
    Header always set Access-Control-Allow-Origin "*"
  </Files>

  # Built assets have hashed names, so they can be cached for a year
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <Else>
    Header set Cache-Control "public, max-age=600"
  </Else>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json application/xml image/svg+xml
</IfModule>
