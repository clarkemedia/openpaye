{
  "name": "openpaye",
  "version": "1.0.0",
  "description": "Open-source Irish salary after tax calculator: Income Tax, USC and PRSI for 2025, 2026 and Budget 2027",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build -c vite.widget.config.ts",
    "build:single": "vite build --mode single",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/google-sans-flex": "^5.3.2",
    "@fontsource-variable/roboto-flex": "^5.3.0",
    "@material/material-color-utilities": "^0.4.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@material-symbols/svg-500": "^0.48.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "preact-render-to-string": "^6.8.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vite-node": "^3.2.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.7"
  },
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/clarkemedia/openpaye.git"
  }
}
